{
  "name": "obsidian-timecodes-plugin",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.build.js production",
    "build:coverage": "node scripts/esbuild.build.js coverage",
    "test:eslint": "eslint --cache --cache-location out/.eslintcache",
    "test:unit": "vitest --coverage"
  },
  "keywords": [
    "obsidian.md",
    "youtube",
    "timecodes"
  ],
  "author": "Kirill Gavrilov",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "catalog:eslint",
    "@stylistic/eslint-plugin": "catalog:eslint",
    "@types/istanbul-lib-instrument": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:testing",
    "enquirer": "catalog:devScripting",
    "esbuild": "catalog:devTools",
    "eslint": "catalog:eslint",
    "eslint-plugin-perfectionist": "catalog:eslint",
    "eslint-plugin-wdio": "catalog:eslint",
    "globals": "catalog:eslint",
    "istanbul-lib-instrument": "catalog:devScripting",
    "obsidian": "catalog:types",
    "obsidian-utils": "catalog:devScripting",
    "typescript": "catalog:devTools",
    "typescript-eslint": "catalog:eslint",
    "vitest": "catalog:testing"
  },
  "packageManager": "pnpm@11.25.0"
}
